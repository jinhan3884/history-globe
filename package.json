{
  "name": "history-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "History Globe — Project Alexandria MVP (vanilla TypeScript + Vite + Cesium).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "cesium": "1.114.0"
  },
  "devDependencies": {
    "@types/cesium": "^1.67.14",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.71.0",
    "prettier": "^3.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
