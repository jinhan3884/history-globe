{
  "$schema": "https://oxlint.org/schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": [
      "warn",
      { "allow": ["__historyAtlasViewer", "__probeMarker"] }
    ]
  },
  "ignorePatterns": ["dist/", "node_modules/", "legacy/", "coverage/", "*.md"]
}
